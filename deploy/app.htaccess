# Apache config for the web build. deploy.yml copies it into the build output and
# replaces __BASE__ with the base href ("/" in production, "/pr-<n>/" for previews).

AddType application/wasm .wasm

# SPA fallback: paths that are not a file or directory go to index.html (path routing).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase __BASE__
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html points at the current hashed bundles: always revalidate.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  # Bundles and fonts carry a content hash in their name and never change.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
